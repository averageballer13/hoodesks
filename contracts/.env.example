# Copy to .env and fill in. .env is gitignored — keep it that way.
# Better still: export these in the shell for the one command that needs them,
# so the key never touches disk at all.

# Private key of the deploying wallet. Use a wallet that holds only what the
# deploy costs. NEVER commit this, never paste it into a chat or an issue.
DEPLOYER_KEY=

# Optional. Defaults to the public endpoint, which is rate-limited but fine
# for a deploy. Use Alchemy or QuickNode for anything that reads in a loop.
RPC_URL=

# Where the protocol's 0.001 ETH per mint goes.
PROTOCOL_WALLET=0xa0A502e18D8EC97FF64338741b3296e65147002f

# The launch token from Pons. Mainnet only — the testnet run mocks it.
DEPOSIT_TOKEN=

# Metadata base. Must end with a slash: the contract appends "<id>.json".
BASE_URI=ipfs://REPLACE_WITH_CID/

# Contract owner. Defaults to the deployer; point it at a multisig for real.
OWNER=

# Whole tokens burned per mint.
DEPOSIT_AMOUNT=1000000
